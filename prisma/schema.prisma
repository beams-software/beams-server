datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tokens {
  token String @unique
}

model Positions {
  id             Int          @id @default(autoincrement())
  priorityNumber Int
  name           String
  wcs            String
  candidates     Candidates[]
  votes          Vote[]
}

model Candidates {
  admid      Int       @unique
  name       String
  grade      Int
  house      String
  startingVotes      Int       @default(0)
  photo      String
  position   Positions @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId Int
  votes      Vote[]
}

model Voters {
  admid     Int     @unique
  name      String
  grade     Int
  class     String
  house     String
  voted     Boolean @default(false)
  votedInfo Json
  votes     Vote[]
}


model Vote {
  id             Int        @id @default(autoincrement())

  voterAdmid     Int
  candidateAdmid Int
  positionId     Int

  voter          Voters     @relation(fields: [voterAdmid], references: [admid], onDelete: Cascade)
  candidate      Candidates @relation(fields: [candidateAdmid], references: [admid], onDelete: Cascade)
  position       Positions  @relation(fields: [positionId], references: [id], onDelete: Cascade)

  createdAt      DateTime   @default(now())

  @@unique([voterAdmid, positionId])
}
